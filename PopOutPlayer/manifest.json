{
    "manifest_version": 3,
    "name": "PopOut Player",
    "version": "1.0",
    "description": "Enable Picture-in-Picture mode for any video on the browser",
    "permissions": ["activeTab", "scripting"],
    "host_permissions": ["<all_urls>"],

    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icon16.png",
            "48": "icon48.png",
            "128": "icon128.png"
        }
    },
    "background": {
        "service_worker": "background.js"
    },
    "commands": {
        "toggle_pip": {
            "suggested_key": {
                "default": "Ctrl+Shift+Q",
                "mac": "Command+Shift+Q"
            },
            "description": "Toggle Picture-in-Picture mode"
        }
    }
}
